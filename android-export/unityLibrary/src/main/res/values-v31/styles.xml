  <style name="BaseUnityTheme" parent="android:Theme.Holo.Light.NoActionBar">
    <item name="android:windowSplashScreenAnimatedIcon">@color/windowSplashScreenAnimatedIconColor</item>
    <item name="android:windowSplashScreenBackground">@color/staticSplashScreenBackgroundColor</item>
    <item name="android:windowSplashScreenIconBackgroundColor">@color/windowSplashScreenIconBackgroundColor</item>
    <item name="android:windowSplashScreenAnimationDuration">0</item>
    <item name="android:windowBackground">@android:color/black</item>
  </style>
  <!--Avoid using the deprecated .Fullscreen extension, as it may interfere with Unity’s initialization of StatusBars insets visibility.-->
</resources>